# ========== 服务器 ==========
HOST=0.0.0.0
PORT=7001

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# ========== 高德地图（第 5 课用） ==========
AMAP_API_KEY=your_amap_api_key_here

# ========== 大模型（第 6 课用，OpenAI 兼容接口） ==========
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_ID=your_model_name
LLM_TIMEOUT=180

PLANNER_MODE=context

# ---------- 可观测性（P2）----------
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_BASE_URL=http://localhost:3000
APP_ENV=dev

# ---------- 会话持久化（P5）----------
CHECKPOINT_URL=sqlite:///data/checkpoints.db

# ---------- 长期记忆（P7）----------
STORE_URL=sqlite:///data/store.db
# 可选：配置后按语义召回。百炼的 embedding 模型，用的是和 LLM 同一个 Key 和 base_url
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024

# ---------- 自建 MCP Server（P8）----------
MCP_PORT=7002
MCP_TOKEN=换成一串随机字符     # 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIP_MCP_URL=http://127.0.0.1:7002/mcp

# ---------- 攻略知识库（P9）----------
KB_DIR=data/chroma